<UserControl x:Class="UrHmi.Ui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="24">
    <TextBlock Style="{DynamicResource ModuleTitleStyle}" Text="{Binding Title}" />
    <TextBlock Style="{DynamicResource BodyTextStyle}"
               Margin="0,0,0,16"
               Text="{Binding Notice}" />
    <TextBlock Style="{DynamicResource BodyTextStyle}"
               Margin="0,0,0,16"
               Foreground="{DynamicResource Brush.Warning}"
               Text="{Binding SafeModeMessage}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource BodyTextStyle}" Text="Robot IP" />
      <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource Brush.Text}" Text="{Binding RobotIp}" />
      <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource BodyTextStyle}" Text="Dashboard port" />
      <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource Brush.Text}" Text="{Binding DashboardPort}" />
      <TextBlock Grid.Row="2" Grid.Column="0" Style="{DynamicResource BodyTextStyle}" Text="RTDE port" />
      <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource Brush.Text}" Text="{Binding RtdePort}" />
      <TextBlock Grid.Row="3" Grid.Column="0" Style="{DynamicResource BodyTextStyle}" Text="PLC IP" />
      <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource Brush.Text}" Text="{Binding PlcIp}" />
      <TextBlock Grid.Row="4" Grid.Column="0" Style="{DynamicResource BodyTextStyle}" Text="PLC transport" />
      <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource Brush.Text}" Text="{Binding PlcTransport}" />
    </Grid>
  </StackPanel>
</UserControl>
