<UserControl x:Class="UrHmi.Ui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UrHmi.Ui.Controls">
  <Grid Margin="12,8,12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="5*" />
      <RowDefinition Height="4*" />
    </Grid.RowDefinitions>
    <TextBlock Style="{DynamicResource ModuleTitleStyle}" Text="Dashboard" />
    <ItemsControl Grid.Row="1"
                  Margin="0,0,0,6"
                  ItemsSource="{Binding Indicators}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4" Rows="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <controls:StatusIndicator Title="{Binding Title}"
                                    ValueText="{Binding DisplayText}"
                                    Kind="{Binding Kind}"
                                    Freshness="{Binding Freshness}"
                                    FreshnessCaption="{Binding FreshnessCaption}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Brush.Surface}"
              CornerRadius="6"
              Margin="4"
              Padding="8">
        <Image Source="pack://application:,,,/UrHmi.Ui;component/Assets/ur-robot.jpg"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />
      </Border>
      <Grid Grid.Column="1" Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource Brush.Surface}"
                CornerRadius="6"
                Padding="12,8">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Muted}"
                       Text="Station status" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Text}"
                       Text="{Binding StationStatusText}" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Muted}"
                       Text="{Binding StationStatusHint}" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.Muted}"
                       Text="{Binding StationStatusCaption}" />
          </StackPanel>
        </Border>
        <UniformGrid Grid.Row="1" Columns="3">
          <Border Style="{DynamicResource MetricCardStyle}">
            <StackPanel>
              <TextBlock Style="{DynamicResource MetricLabelStyle}" Text="UPH" />
              <TextBlock Style="{DynamicResource MetricValueStyle}" Text="{Binding UphText}" />
              <TextBlock Style="{DynamicResource MetricCaptionStyle}" Text="sin dato" />
            </StackPanel>
          </Border>
          <Border Style="{DynamicResource MetricCardStyle}">
            <StackPanel>
              <TextBlock Style="{DynamicResource MetricLabelStyle}" Text="Current cycle time" />
              <TextBlock Style="{DynamicResource MetricValueStyle}" Text="{Binding CurrentCycleTimeText}" />
              <TextBlock Style="{DynamicResource MetricCaptionStyle}" Text="sin dato" />
            </StackPanel>
          </Border>
          <Border Style="{DynamicResource MetricCardStyle}">
            <StackPanel>
              <TextBlock Style="{DynamicResource MetricLabelStyle}" Text="Previous cycle time" />
              <TextBlock Style="{DynamicResource MetricValueStyle}" Text="{Binding PreviousCycleTimeText}" />
              <TextBlock Style="{DynamicResource MetricCaptionStyle}" Text="sin dato" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
