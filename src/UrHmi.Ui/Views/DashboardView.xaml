<UserControl x:Class="UrHmi.Ui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UrHmi.Ui.Controls">
  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top"
               Style="{DynamicResource ModuleTitleStyle}"
               Text="Dashboard" />
    <TextBlock DockPanel.Dock="Top"
               Style="{DynamicResource BodyTextStyle}"
               Margin="0,0,0,16"
               Text="Process values stay unavailable until robot and PLC channels are implemented. Connection lamps reflect actual placeholder link state, not inferred robot status." />
    <ItemsControl ItemsSource="{Binding Indicators}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <controls:StatusIndicator Title="{Binding Title}"
                                    ValueText="{Binding DisplayText}"
                                    Kind="{Binding Kind}"
                                    Freshness="{Binding Freshness}"
                                    FreshnessCaption="{Binding FreshnessCaption}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
