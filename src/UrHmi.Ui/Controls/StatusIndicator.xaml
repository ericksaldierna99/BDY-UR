<UserControl x:Class="UrHmi.Ui.Controls.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220"
             MinHeight="110"
             Margin="8">
  <Border x:Name="Chrome"
          Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.CommsLoss}"
          BorderThickness="3,3,3,3"
          CornerRadius="6"
          Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Rectangle x:Name="KindMark"
                   Width="10"
                   Height="10"
                   Margin="0,0,8,0"
                   Fill="{DynamicResource Brush.CommsLoss}" />
        <TextBlock x:Name="TitleText"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.Muted}"
                   Text="Title" />
      </StackPanel>
      <TextBlock x:Name="ValueTextBlock"
                 Grid.Row="1"
                 Margin="0,8,0,8"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Text}"
                 Text="—"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="FreshnessText"
                 Grid.Row="2"
                 FontSize="11"
                 Foreground="{DynamicResource Brush.Muted}" />
    </Grid>
  </Border>
</UserControl>
