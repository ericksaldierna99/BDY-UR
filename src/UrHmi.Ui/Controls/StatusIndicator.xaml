<UserControl x:Class="UrHmi.Ui.Controls.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="140"
             MinHeight="72"
             Margin="4"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Border x:Name="Chrome"
          Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.CommsLoss}"
          BorderThickness="3"
          CornerRadius="6"
          Padding="8,6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Rectangle x:Name="KindMark"
                   Width="8"
                   Height="8"
                   Margin="0,0,6,0"
                   VerticalAlignment="Center"
                   Fill="{DynamicResource Brush.CommsLoss}" />
        <TextBlock x:Name="TitleText"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Muted}"
                   Text="Title"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />
      </StackPanel>
      <TextBlock x:Name="ValueTextBlock"
                 Grid.Row="1"
                 Margin="0,2,0,2"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Text}"
                 Text="—"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"
                 VerticalAlignment="Center" />
      <TextBlock x:Name="FreshnessText"
                 Grid.Row="2"
                 FontSize="10"
                 Foreground="{DynamicResource Brush.Muted}"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</UserControl>
