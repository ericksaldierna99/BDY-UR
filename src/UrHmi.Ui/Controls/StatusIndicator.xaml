<UserControl x:Class="UrHmi.Ui.Controls.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260"
             MinHeight="160"
             Margin="8"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Border x:Name="Chrome"
          Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.CommsLoss}"
          BorderThickness="4"
          CornerRadius="8"
          Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Rectangle x:Name="KindMark"
                   Width="14"
                   Height="14"
                   Margin="0,0,10,0"
                   Fill="{DynamicResource Brush.CommsLoss}" />
        <TextBlock x:Name="TitleText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Muted}"
                   Text="Title"
                   TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock x:Name="ValueTextBlock"
                 Grid.Row="1"
                 Margin="0,12,0,12"
                 FontSize="32"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Text}"
                 Text="—"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
      <TextBlock x:Name="FreshnessText"
                 Grid.Row="2"
                 FontSize="14"
                 Foreground="{DynamicResource Brush.Muted}" />
    </Grid>
  </Border>
</UserControl>
