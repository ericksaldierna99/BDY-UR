<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:UrHmi.Ui.Views;assembly=UrHmi.Ui"
                    xmlns:alarms="clr-namespace:UrHmi.Presentation.Alarms;assembly=UrHmi.Presentation"
                    xmlns:dash="clr-namespace:UrHmi.Presentation.Dashboard;assembly=UrHmi.Presentation"
                    xmlns:settings="clr-namespace:UrHmi.Presentation.Settings;assembly=UrHmi.Presentation"
                    xmlns:tools="clr-namespace:UrHmi.Presentation.Tools;assembly=UrHmi.Presentation">
  <DataTemplate DataType="{x:Type dash:DashboardViewModel}">
    <views:DashboardView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type alarms:AlarmsViewModel}">
    <views:AlarmsView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type tools:ToolsViewModel}">
    <views:ToolsView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
    <views:SettingsView />
  </DataTemplate>
</ResourceDictionary>
