<Window x:Class="UrHmi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UR Robot Interfaz"
        Width="1600"
        Height="1000"
        MinWidth="1280"
        MinHeight="800"
        Style="{DynamicResource ShellWindowStyle}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0" Background="{DynamicResource Brush.Surface}">
      <TextBlock DockPanel.Dock="Top"
                 Margin="20,24,20,16"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Text}"
                 Text="UR Robot Interfaz" />
      <ListBox Margin="12,0,12,16"
               ItemsSource="{Binding Modules}"
               SelectedItem="{Binding CurrentModule}"
               Style="{DynamicResource NavListBoxStyle}"
               ItemContainerStyle="{DynamicResource NavItemStyle}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="1" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Binding DisplayName}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Border Grid.Column="1" Background="{DynamicResource Brush.Background}">
      <ContentControl Content="{Binding CurrentViewModel}" />
    </Border>
  </Grid>
</Window>
