<Window x:Class="UrHmi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UR Robot Interfaz"
        Width="1280"
        Height="720"
        MinWidth="1024"
        MinHeight="640"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Style="{DynamicResource ShellWindowStyle}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="168" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0" Background="{DynamicResource Brush.Surface}">
      <TextBlock DockPanel.Dock="Top"
                 Margin="12,12,12,8"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Text}"
                 Text="UR Robot Interfaz"
                 TextWrapping="Wrap" />
      <ListBox Margin="6,0,6,8"
               ItemsSource="{Binding Modules}"
               SelectedItem="{Binding CurrentModule}"
               Style="{DynamicResource NavListBoxStyle}"
               ItemContainerStyle="{DynamicResource NavItemStyle}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="1" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Binding DisplayName}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Border Grid.Column="1" Background="{DynamicResource Brush.Background}">
      <ContentControl Content="{Binding CurrentViewModel}" />
    </Border>
  </Grid>
</Window>
