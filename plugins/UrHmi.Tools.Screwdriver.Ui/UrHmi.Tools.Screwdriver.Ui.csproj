<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>UrHmi.Tools.Screwdriver.Ui</RootNamespace>
    <AssemblyName>UrHmi.Tools.Screwdriver.Ui</AssemblyName>
    <Description>WPF view for the screwdriver tool module. Loaded as a plugin; not referenced by HMI core.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UrHmi.Tools.Screwdriver\UrHmi.Tools.Screwdriver.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\src\UrHmi.Tools.Abstractions\UrHmi.Tools.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CopyToAppPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_AppPluginsDir>$(MSBuildThisFileDirectory)..\..\src\UrHmi.App\bin\$(Configuration)\$(TargetFramework)\plugins\</_AppPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(_AppPluginsDir)" />
    <ItemGroup>
      <_UiPluginCopy Include="$(TargetPath)" />
      <_UiPluginCopy Include="$(TargetDir)$(TargetName).deps.json" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_UiPluginCopy)" DestinationFolder="$(_AppPluginsDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
